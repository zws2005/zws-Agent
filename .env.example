# 阿里云百炼（推荐）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（可选）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web Search（默认 bing；也可选 duckduckgo / tavily）
WEB_SEARCH_PROVIDER=bing
# TAVILY_API_KEY=

# 动态评论采集（浏览器默认自动查找系统 Chromium）
# CHROMIUM_PATH=/usr/bin/chromium

# 京东商品评论。公开页面被风控限制时，从已登录浏览器复制 Cookie 请求头。
# JD_COOKIE=
# JD_STORAGE_STATE=/absolute/path/to/jd-storage-state.json

# 抖音视频评论。抖音通常要求登录态。
# DOUYIN_COOKIE=
# DOUYIN_STORAGE_STATE=/absolute/path/to/douyin-storage-state.json
